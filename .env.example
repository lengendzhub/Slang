# TailorAI / Slang Environment Configuration Example

# Frontend Environment
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME="TailorAI"

# Backend Environment
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Database Configuration (PostgreSQL + pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tailorai
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tailorai

# Redis Configuration (Job Queue & Caching)
REDIS_URL=redis://localhost:6379/0

# LLM Providers
# Option A: Groq Cloud (Fast free inference with key pool rotation)
GROQ_API_KEYS=gsk_your_key_1,gsk_your_key_2

# Option B: Ollama (Local or self-hosted)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest

# Authentication
AUTH_SECRET=generate_with_openssl_rand_hex_32
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Sandbox LaTeX Compilation
TECTONIC_BIN=tectonic
PDFLATEX_BIN=pdflatex
SANDBOX_TIMEOUT_SECONDS=30
